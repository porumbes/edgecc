// Rank variables N (a dim) and A (a tensor) would shadow those names in the generated loops.
dim N = 2;
tensor Z[R=N]      : float, empty = 0.0;
tensor A[R=N, C=N] : float, empty = 0.0;
tensor B[R=N]      : float, empty = 0.0;
init A = [[1.0, 2.0], [3.0, 4.0]];
init B = [1.0, 1.0];
Z[A] = A[A,N] . B[N] :: map(mul, intersect) reduce(add, union);
