// 9 cross-generational tensors exceeds the limit (DFT gap G4).
dim N = 2;
tensor G[R=N, C=N] : float, empty = 0.0;
tensor P0[gen I, R=N] : float, empty = 0.0;
tensor P1[gen I, R=N] : float, empty = 0.0;
tensor P2[gen I, R=N] : float, empty = 0.0;
tensor P3[gen I, R=N] : float, empty = 0.0;
tensor P4[gen I, R=N] : float, empty = 0.0;
tensor P5[gen I, R=N] : float, empty = 0.0;
tensor P6[gen I, R=N] : float, empty = 0.0;
tensor P7[gen I, R=N] : float, empty = 0.0;
tensor P8[gen I, R=N] : float, empty = 0.0;
init G = [[0.0, 1.0], [0.0, 0.0]];
init P0 = [1.0, 0.0];
init P1 = [1.0, 0.0];
init P2 = [1.0, 0.0];
init P3 = [1.0, 0.0];
init P4 = [1.0, 0.0];
init P5 = [1.0, 0.0];
init P6 = [1.0, 0.0];
init P7 = [1.0, 0.0];
init P8 = [1.0, 0.0];
P0[i+1, d] = G[s,d] . P0[i, s] :: map(and, intersect) reduce(or, union);
P1[i+1, d] = P1[i, d] . P0[i+1, d] :: map(or, union) reduce(or, union);
P2[i+1, d] = P2[i, d] . P1[i+1, d] :: map(or, union) reduce(or, union);
P3[i+1, d] = P3[i, d] . P2[i+1, d] :: map(or, union) reduce(or, union);
P4[i+1, d] = P4[i, d] . P3[i+1, d] :: map(or, union) reduce(or, union);
P5[i+1, d] = P5[i, d] . P4[i+1, d] :: map(or, union) reduce(or, union);
P6[i+1, d] = P6[i, d] . P5[i+1, d] :: map(or, union) reduce(or, union);
P7[i+1, d] = P7[i, d] . P6[i+1, d] :: map(or, union) reduce(or, union);
P8[i+1, d] = P8[i, d] . P7[i+1, d] :: map(or, union) reduce(or, union);
stop: stable(P8);
