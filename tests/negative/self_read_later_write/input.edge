// B is first written by one Einsum, then read and written by a later one. The
// generated loop overwrote B[s] while still reading it (loop-order dependent
// garbage). Rejected: use a generational rank for an in-place update.
dim N = 3;
tensor M[R=N, C=N] : float, empty = 0.0;
tensor A[R=N] : float, empty = 0.0;
tensor B[R=N] : float, empty = 0.0;
tensor Z[R=N] : float, empty = 0.0;
init M = [[0,1,0],[0,0,1],[1,0,0]];
init A = [1.0, 2.0, 3.0];
B[i] = A[i] . A[i] :: map(mul, intersect) reduce(add, union);
B[d] = B[s] . M[s,d] :: map(mul, intersect) reduce(add, union);
Z[i] = B[i] . A[i] :: map(mul, intersect) reduce(add, union);
