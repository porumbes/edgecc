// Widest (max-bottleneck) path from node 0; source bottleneck = 1e9.
dim N = *;
tensor G[R=N, C=N]   : float, empty = 0.0;   // capacities; 0.0 = no edge
tensor F[gen I, R=N] : float, empty = 0.0;   // wavefront bottlenecks
tensor D[gen I, R=N] : float, empty = 0.0;   // best-known bottleneck (watched)
init G = load("graph.mtx");
init F = seed(source=0, value=1000000000.0);
init D = seed(source=0, value=1000000000.0);
F[i+1, d] = G[s,d] . F[i,s]   :: map(min, intersect) reduce(max, union);
D[i+1, d] = D[i,d] . F[i+1,d] :: map(max, union) reduce(max, union);
stop: stable(D);
