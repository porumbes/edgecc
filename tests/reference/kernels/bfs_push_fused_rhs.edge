// Reachability from node 0: fused push, paren on the right  !P .2 (G .1 F)
dim N = *;
tensor G[R=N, C=N]   : float, empty = 0.0;
tensor F[gen I, R=N] : float, empty = 0.0;   // frontier
tensor P[gen I, R=N] : float, empty = 0.0;   // visited (watched)
init G = load("graph.mtx");
init F = seed(source=0, value=1.0);
init P = seed(source=0, value=1.0);
F[i+1, d] = !P[i,d] .2 (G[s,d] .1 F[i,s]) :: map.1(and,intersect) reduce.1(or,union) map.2(and,intersect);
P[i+1, d] = P[i,d] . F[i+1,d] :: map(or,union) reduce(or,union);
stop: stable(P);
