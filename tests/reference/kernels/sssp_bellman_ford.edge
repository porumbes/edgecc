// SSSP from node 0: Bellman-Ford cascade (relax, then combine)
dim N = *;
tensor W[R=N, C=N]   : float, empty = 0.0;   // loaded weights; 0.0 = no edge
tensor D[gen I, R=N] : float, empty = inf;   // distances (watched)
init W = load("graph.mtx");
init D = seed(source=0, value=0.0);
tensor T[gen I, R=N] : float, empty = inf;   // relaxed candidates (intermediate)
T[i, d]   = W[s,d] . D[i, s] :: map(add, intersect) reduce(min, union);
D[i+1, d] = D[i, d] . T[i, d] :: map(min, union) reduce(min, union);
stop: stable(D);
