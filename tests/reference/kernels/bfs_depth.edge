// BFS hop depth from node 0 (run on the 0/1 pattern graph).
dim N = *;
tensor G[R=N, C=N]   : float, empty = 0.0;
tensor C[gen I, R=N] : float, empty = inf;   // candidate depths (intermediate)
tensor F[gen I, R=N] : float, empty = inf;   // frontier depths
tensor D[gen I, R=N] : float, empty = inf;   // discovery depth (watched)
init G = load("graph.mtx");
init F = seed(source=0, value=0.0);
init D = seed(source=0, value=0.0);
C[i, d]   = G[s,d] . F[i,s] :: map(add, intersect) reduce(min, union);
F[i+1, d] = C[i,d] . D[i,d] :: map(take_left, take_left_only) reduce(min, union);
D[i+1, d] = D[i,d] . F[i+1,d] :: map(min, union) reduce(min, union);
stop: stable(D);
