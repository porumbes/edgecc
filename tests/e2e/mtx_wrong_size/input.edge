// A 4 x 4 .mtx file loaded into a 3 x 3 tensor is rejected when it is loaded
// (before the load-time shape check the loops silently truncated it).
dim N = 3;
tensor G[R=N, C=N] : float, empty = 0.0;
tensor Z[R=N]      : float, empty = 0.0;
init G = load("g.mtx");
Z[i] = G[i,k] . G[k,i] :: map(mul, intersect) reduce(add, union);
