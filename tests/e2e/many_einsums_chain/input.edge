// More than 16 Einsums in one program (DFT gap G4).
dim N = 2;
tensor A0[R=N] : float, empty = 0.0;
tensor A1[R=N] : float, empty = 0.0;
tensor A2[R=N] : float, empty = 0.0;
tensor A3[R=N] : float, empty = 0.0;
tensor A4[R=N] : float, empty = 0.0;
tensor A5[R=N] : float, empty = 0.0;
tensor A6[R=N] : float, empty = 0.0;
tensor A7[R=N] : float, empty = 0.0;
tensor A8[R=N] : float, empty = 0.0;
tensor A9[R=N] : float, empty = 0.0;
tensor A10[R=N] : float, empty = 0.0;
tensor A11[R=N] : float, empty = 0.0;
tensor A12[R=N] : float, empty = 0.0;
tensor A13[R=N] : float, empty = 0.0;
tensor A14[R=N] : float, empty = 0.0;
tensor A15[R=N] : float, empty = 0.0;
tensor A16[R=N] : float, empty = 0.0;
tensor A17[R=N] : float, empty = 0.0;
tensor A18[R=N] : float, empty = 0.0;
tensor A19[R=N] : float, empty = 0.0;
tensor Z[R=N] : float, empty = 0.0;
init A0 = [1.0, 2.0];
A1[i] = A0[i] . A0[i] :: map(add, intersect) reduce(add, union);
A2[i] = A1[i] . A0[i] :: map(add, intersect) reduce(add, union);
A3[i] = A2[i] . A0[i] :: map(add, intersect) reduce(add, union);
A4[i] = A3[i] . A0[i] :: map(add, intersect) reduce(add, union);
A5[i] = A4[i] . A0[i] :: map(add, intersect) reduce(add, union);
A6[i] = A5[i] . A0[i] :: map(add, intersect) reduce(add, union);
A7[i] = A6[i] . A0[i] :: map(add, intersect) reduce(add, union);
A8[i] = A7[i] . A0[i] :: map(add, intersect) reduce(add, union);
A9[i] = A8[i] . A0[i] :: map(add, intersect) reduce(add, union);
A10[i] = A9[i] . A0[i] :: map(add, intersect) reduce(add, union);
A11[i] = A10[i] . A0[i] :: map(add, intersect) reduce(add, union);
A12[i] = A11[i] . A0[i] :: map(add, intersect) reduce(add, union);
A13[i] = A12[i] . A0[i] :: map(add, intersect) reduce(add, union);
A14[i] = A13[i] . A0[i] :: map(add, intersect) reduce(add, union);
A15[i] = A14[i] . A0[i] :: map(add, intersect) reduce(add, union);
A16[i] = A15[i] . A0[i] :: map(add, intersect) reduce(add, union);
A17[i] = A16[i] . A0[i] :: map(add, intersect) reduce(add, union);
A18[i] = A17[i] . A0[i] :: map(add, intersect) reduce(add, union);
A19[i] = A18[i] . A0[i] :: map(add, intersect) reduce(add, union);
Z[i] = A19[i] . A0[i] :: map(add, intersect) reduce(add, union);
