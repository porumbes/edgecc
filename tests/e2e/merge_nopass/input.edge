// nopass merge always rejects: every map iteration is skipped, so the
// reduction state stays at the compute-op identity (0.0 for add).
dim N = 3;

tensor Z[R=N] : float, empty = 0.0;
tensor A[R=N] : float, empty = 0.0;
tensor B[R=N] : float, empty = 0.0;

init A = [1.0, 2.0, 3.0];
init B = [4.0, 5.0, 6.0];

Z[n] = A[n] . B[n] :: map(mul, nopass) reduce(add);
