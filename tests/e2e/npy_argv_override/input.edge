// Fixture g_arg.npy is written by tests/e2e/npy_fixtures.py.
// An argv override (args: g_arg.npy) replaces the .mtx default with a .npy file:
// the extension of the path actually opened picks the format.
dim N = *;
tensor G[R=N, C=N] : float, empty = 0.0;
tensor Z[R=N]      : float, empty = 0.0;
init G = load("g.mtx");
Z[i] = G[i,k] . G[k,i] :: map(mul, intersect) reduce(add, union);
