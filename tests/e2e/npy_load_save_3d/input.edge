// Fixture a.npy (int64) is written by tests/e2e/npy_fixtures.py.
// DFT gap G9: a 3-D tensor loaded from .npy (ints cast to float) and a 3-D result
// saved to .npy, re-read by the runner (roundtrip_check).
dim H = 2;
dim TWO = 2;
tensor A[M=H, B=TWO, D=TWO] : float, empty = 0.0;
tensor Z[M=H, B=TWO, D=TWO] : float, empty = 0.0;
init A = load("a.npy");
Z[m,b,d] = A[m,b,d] . A[m,b,d] :: map(mul, intersect) reduce(add, union);
save: Z -> "z.npy";
