// Bellman-Ford expressed as a 3-Einsum cascade with TWO intra-generation
// intermediates (T1, T2), to exercise the multi-intermediate (n>1) path.
// Per generation: T1 = relaxed candidates from D; T2 = min(D, T1) (merged
// distances); then commit D[i+1] = min(D, T2). D is cross-generational.
// SSA chain: T1 (written) -> read by T2's Einsum -> T2 read by D's Einsum.
// Same graph/source as bellman_ford; converges to [0, 1, 3, 6].
dim N = 4;

tensor W[R=N, C=N]    : float, empty = inf;
tensor T1[gen I, R=N] : float, empty = inf;
tensor T2[gen I, R=N] : float, empty = inf;
tensor D[gen I, R=N]  : float, empty = inf;

init W = [[inf, 1.0, 4.0, inf], [inf, inf, 2.0, 6.0], [inf, inf, inf, 3.0], [inf, inf, inf, inf]];
init D = [0.0, inf, inf, inf];

T1[i, d]  = W[s,d] . D[i, s]  :: map(add, intersect) reduce(min, union);   // relax: candidates
T2[i, d]  = D[i, d] . T1[i, d] :: map(min, union) reduce(min, union);      // merge: min(D, candidates)
D[i+1, d] = D[i, d] . T2[i, d] :: map(min, union) reduce(min, union);      // commit
stop: stable(D);
