// GEMM: Z = A^T * B using EDGE
dim M = 2;
dim K = 3;
dim N = 2;

tensor Z[R=M, C=N] : float, empty = 0.0;
tensor A[R=K, C=M] : float, empty = 0.0;
tensor B[R=K, C=N] : float, empty = 0.0;

init A = [[1, 2], [3, 4], [5, 6]];
init B = [[7, 8], [9, 10], [11, 12]];

Z[m,n] = A[k,m] . B[k,n] :: map(mul) reduce(add);
